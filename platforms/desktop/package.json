{
  "name": "sorrydotcom-studio",
  "productName": "Void Shadow Studio",
  "version": "0.1.0",
  "description": "Void Shadow Studio production editor",
  "author": "Sorrydotcom Studio",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:windows": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.sorrydotcom.editor",
    "productName": "Void Shadow Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "www/**/*",
      "package.json",
      "build/icon.png",
      "updater.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "webscepts123",
        "repo": "sorrydotcomeditor",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
