html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    title "Movie Poster Studio — Production Hub"
    link rel="stylesheet" href="/public/app.css"
    script src="/public/navigation.js" defer="defer"
  body
    div.app-shell
      nav.side-nav
        h2.brand "VOID"
          span.brand-mark "S"
        for item in navigation
          if item.submenu
            div.nav-group
              div.nav-group-heading
                if item.href
                  a.nav-link href="{{item.href}}" "{{item.label}}"
                else
                  span.nav-group-label "{{item.label}}"
                button.nav-toggle type="button" aria-expanded="true" aria-controls="{{item.id}}" aria-label="Toggle {{item.label}} submenu" "+"
              div.nav-submenu id="{{item.id}}"
                for link in item.links
                  a.submenu-link href="{{link.href}}" "{{link.label}}"
          else
            a.nav-link href="{{item.href}}" "{{item.label}}"
        form method="post" action="/logout"
          button.nav-logout type="submit" "Logout"
      main.content
        div.topbar
          p "SYSTEM STATUS: ACTIVE"
          form method="get" action="/scenes/create"
            button.secondary type="submit" "NEW CLIP +"
        p.eyebrow "PRODUCTION HUB / POSTER STUDIO"
        div.page-heading
          h1 "Movie Poster Studio"
          a.nav-link href="/projects" "Projects"
        if message
          p.notice "{{message}}"
        p.muted "Choose a project, draft the tagline and creative direction, then generate a poster."
        if hasRows
          for project in projects
            article.record-card
              h2 "{{project.title}}"
              p.muted "{{project.summary}}"
              if project.posterUrl
                img.project-poster src="{{project.posterUrl}}" alt="Generated movie poster"
              form.form-card method="post" action="/posters/generate-ideas"
                input type="hidden" name="project_id" value="{{project.id}}"
                button.secondary type="submit" "Generate poster ideas with AI"
              form.form-card method="post" action="/posters/generate"
                input type="hidden" name="project_id" value="{{project.id}}"
                label for="{{project.taglineId}}" "Tagline"
                input id="{{project.taglineId}}" type="text" name="tagline" value=""
                label for="{{project.directionId}}" "Creative direction"
                textarea id="{{project.directionId}}" name="direction" rows="4" ""
                button.primary type="submit" "Generate AI poster"
        else
          article.record-card
            h2 "No productions available"
            p.muted "Create a project before generating its poster."
            a.primary-link href="{{createHref}}" "Initialize project"
