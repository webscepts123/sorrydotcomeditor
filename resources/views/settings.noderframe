html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    title "Settings — Production Hub"
    link rel="stylesheet" href="/public/app.css?v=2"
    script src="/public/navigation.js" defer="defer"
    script src="/public/project-show.js?v=2" defer="defer"
  body
    div.app-shell
      nav.side-nav
        h2.brand "VOID"
          span.brand-mark "S"
        for item in navigation
          if item.submenu
            div.nav-group
              div.nav-group-heading
                if item.href
                  a.nav-link href="{{item.href}}" "{{item.label}}"
                else
                  span.nav-group-label "{{item.label}}"
                button.nav-toggle type="button" aria-expanded="true" aria-controls="{{item.id}}" aria-label="Toggle {{item.label}} submenu" "+"
              div.nav-submenu id="{{item.id}}"
                for link in item.links
                  a.submenu-link href="{{link.href}}" "{{link.label}}"
          else
            a.nav-link href="{{item.href}}" "{{item.label}}"
        form method="post" action="/logout"
          button.nav-logout type="submit" "Logout"
      main.content
        div.topbar
          p "SYSTEM STATUS: ACTIVE"
          form method="get" action="/scenes/create"
            button.secondary type="submit" "NEW CLIP +"
        p.eyebrow "PRODUCTION HUB / SYSTEM"
        h1 "System settings"
        if message
          p.notice "{{message}}"
        article#kaggle.record-card.settings-card
          h2 "Kaggle account"
          p.muted "Connect once to use Kaggle across all projects and scenes in your studio account. Credentials are stored encrypted."
          if kaggleConnected
            p.settings-state.is-on "Connected as {{kaggleUsername}}"
            form method="post" action="/settings/kaggle/disconnect"
              button.danger type="submit" "Disconnect Kaggle"
          else
            if kaggleAvailable
              p.settings-state "Not connected"
            else
              p.settings-state.is-off "Kaggle runtime unavailable"
            p.muted "{{kaggleMessage}}"
            form.settings-form method="post" action="/settings/kaggle/connect" autocomplete="off"
              label for="kaggle-username" "Kaggle username"
              input#kaggle-username type="text" name="username" maxlength="64" autocomplete="off" spellcheck="false"
              label for="kaggle-secret" "API token or kaggle.json contents"
              input#kaggle-secret type="password" name="secret" required="required" maxlength="4096" autocomplete="new-password"
              p.field-help "Enter your Kaggle username with a token or legacy key. A full kaggle.json file already includes the username."
              a.nav-link href="https://www.kaggle.com/settings/api" target="_blank" rel="noopener noreferrer" "Open Kaggle API settings"
              label for="kaggle-kind" "Credential type"
              select#kaggle-kind name="kind"
                option value="auto" selected="selected" "Detect automatically"
                option value="token" "API token"
                option value="legacy" "Legacy key from kaggle.json"
              button.primary type="submit" "Connect Kaggle"
          div.detail-row
            strong "Kaggle Python runtime"
            p "{{kagglePython}}"
        article#comfyui.record-card.settings-card
          h2 "ComfyUI render server"
          p.muted "Required for ComfyUI renders only. Enter the URL of a running worker reachable from the live studio. Kaggle generation uses your Kaggle account."
          form.settings-form method="post" action="/settings"
            for setting in comfySettings
              label for="{{setting.name}}" "{{setting.label}}"
              if setting.hasOptions
                select id="{{setting.name}}" name="{{setting.name}}"
                  for option in setting.options
                    if option.selected
                      option value="{{option.value}}" selected="selected" "{{option.label}}"
                    else
                      option value="{{option.value}}" "{{option.label}}"
              else
                input id="{{setting.name}}" type="text" name="{{setting.name}}" value="{{setting.value}}" placeholder="{{setting.placeholder}}" spellcheck="false"
              p.field-help "{{setting.help}} · {{setting.source}}"
              if setting.overridden
                button.link-button type="submit" name="reset" value="{{setting.name}}" "Reset to server value"
            div.action-row
              button.primary type="submit" "Save ComfyUI settings"
          form method="post" action="/settings/test-render"
            input type="hidden" name="target" value="comfy"
            button.secondary type="submit" "Test ComfyUI connection"
        article.record-card.settings-card
          h2 "Local Wan 2.1 (this machine)"
          p.muted "ComfyUI running on the same computer as the editor. Start it with npm run wan:start."
          form.settings-form method="post" action="/settings"
            for setting in localSettings
              label for="{{setting.name}}" "{{setting.label}}"
              if setting.hasOptions
                select id="{{setting.name}}" name="{{setting.name}}"
                  for option in setting.options
                    if option.selected
                      option value="{{option.value}}" selected="selected" "{{option.label}}"
                    else
                      option value="{{option.value}}" "{{option.label}}"
              else
                input id="{{setting.name}}" type="text" name="{{setting.name}}" value="{{setting.value}}" placeholder="{{setting.placeholder}}" spellcheck="false"
              p.field-help "{{setting.help}} · {{setting.source}}"
              if setting.overridden
                button.link-button type="submit" name="reset" value="{{setting.name}}" "Reset to server value"
            div.action-row
              button.primary type="submit" "Save Local Wan settings"
          form method="post" action="/settings/test-render"
            input type="hidden" name="target" value="local"
            button.secondary type="submit" "Test Local Wan connection"
        article.record-card
          h2 "Server configuration"
          p.muted "Database, AI keys and the Kaggle Python path are set in the server .env file and are not editable here."
          for field in fields
            div.detail-row
              strong "{{field.label}}"
              p "{{field.value}}"
          p.muted "Application health endpoint: /health"
