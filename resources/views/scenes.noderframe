html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    title "{{title}} — Production Hub"
    link rel="stylesheet" href="/public/app.css?v=2"
    script src="/public/navigation.js" defer="defer"
    script src="/public/project-show.js?v=2" defer="defer"
    link rel="stylesheet" href="/public/scene-progress.css?v=3"
    script src="/public/scene-progress.js?v=3" defer="defer"
  body
    div.app-shell
      nav.side-nav
        h2.brand "VOID"
          span.brand-mark "S"
        for item in navigation
          if item.submenu
            div.nav-group
              div.nav-group-heading
                if item.href
                  a.nav-link href="{{item.href}}" "{{item.label}}"
                else
                  span.nav-group-label "{{item.label}}"
                button.nav-toggle type="button" aria-expanded="true" aria-controls="{{item.id}}" aria-label="Toggle {{item.label}} submenu" "+"
              div.nav-submenu id="{{item.id}}"
                for link in item.links
                  a.submenu-link href="{{link.href}}" "{{link.label}}"
          else
            a.nav-link href="{{item.href}}" "{{item.label}}"
        form method="post" action="/logout"
          button.nav-logout type="submit" "Logout"
      main.content
        div.topbar
          p "SYSTEM STATUS: ACTIVE"
          form method="get" action="/scenes/create"
            button.secondary type="submit" "NEW CLIP +"
        p.eyebrow "PRODUCTION HUB / SCENE SEQUENCER"
        div.page-heading
          h1 "{{title}}"
          if pageType == "index"
            a.primary-link href="{{createHref}}" "Add scene"
        if message
          p.notice "{{message}}"
        if pageType == "index"
          p.muted "Scenes are production beats linked to a project, cast, and render job."
          if hasRows
            for row in rows
              article.record-card
                a.record-title href="{{row.href}}" "{{row.title}}"
                p.muted "{{row.summary}}"
                span.status "{{row.status}}"
          else
            article.record-card
              h2 "No scenes yet"
              p.muted "Choose a production and add its first timeline sequence."
              a.primary-link href="{{createHref}}" "Create scene"
        if pageType == "form"
          form.form-card method="post" action="{{formAction}}"
            for field in fields
              label for="{{field.name}}" "{{field.label}}"
              if field.multiline
                textarea id="{{field.name}}" name="{{field.name}}" rows="6" "{{field.value}}"
              else if field.type == "select"
                select id="{{field.name}}" name="{{field.name}}"
                  for option in field.options
                    if option.selected
                      option value="{{option.value}}" selected="selected" "{{option.label}}"
                    else
                      option value="{{option.value}}" "{{option.label}}"
              else
                input id="{{field.name}}" type="{{field.type}}" name="{{field.name}}" value="{{field.value}}"
            button.primary type="submit" "{{submitLabel}}"
          a.nav-link href="{{cancelHref}}" "Cancel"
        if pageType == "show"
          article.record-card
            h2 "Sequence {{scene.order_index}}"
            p.muted "{{scene.script_segment}}"
            span.status "{{scene.status}}"
            p "Project: {{projectTitle}}"
            if renderBusy
              section.render-progress.is-queued data-progress-url="{{progressUrl}}" aria-live="polite"
                div.render-progress-head
                  div.render-progress-heading
                    span.render-progress-spinner aria-hidden="true"
                    strong.render-progress-title "Generating scene"
                  span.render-progress-percent "0%"
                div.render-progress-track role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Scene generation progress" title="Click to check now"
                  div.render-progress-fill
                ol.render-progress-steps
                  li data-step="queued" "Queued"
                  li data-step="running" "Generating"
                  li data-step="downloading" "Importing"
                  li data-step="ready" "Ready"
                div.render-progress-meta
                  span.render-progress-elapsed "Elapsed 0:00"
                  span.render-progress-eta "Estimating…"
                  span.render-progress-next ""
                p.render-progress-message.muted "Connecting to the render job…"
                div.render-progress-actions
                  button.secondary.render-progress-check type="button" "Check now"
                  button.secondary.render-progress-toggle type="button" aria-pressed="false" "Pause auto-refresh"
                  form.render-progress-cancel method="post" action="{{cancelRenderAction}}" hidden="hidden"
                    button.danger type="submit" "Cancel stuck job"
                  a.render-progress-notebook href="#" target="_blank" rel="noopener" hidden="hidden" "Open Kaggle notebook ↗"
            if videoUrl
              div.scene-preview
                a.nav-link href="{{videoUrl}}" data-scene-video="true" "Open rendered clip"
            div.action-row
              a.primary-link href="{{editHref}}" "Edit sequence"
              if videoUrl
                if renderBusy
                  button.secondary type="button" disabled="disabled" "Recreate video on Kaggle"
                else
                  form method="post" action="{{recreateAction}}"
                    button.primary type="submit" "Recreate video on Kaggle"
              if renderBusy
                p.muted "A generation job is already running."
              else if comfyConfigured
                form method="post" action="{{renderAction}}"
                  button.primary type="submit" "Queue ComfyUI render"
              if kaggleRender
                a.nav-link href="{{videoEditorHref}}" "Check Kaggle progress in video editor"
              else
                a.nav-link href="{{videoEditorHref}}" "Open AI Engine"
                if comfyConfigured
                  if scene.generation_job_id
                    form method="post" action="{{syncAction}}"
                      button.secondary type="submit" "Check render status"
              form method="post" action="{{deleteAction}}"
                button.danger type="submit" "Delete sequence"
          form.form-card method="post" action="{{linkNotebookAction}}"
            h2 "Link a Kaggle notebook"
            p.muted "In Kaggle, use Save Version with Run All to start a saved run. Once it is queued, link the notebook to import its 1080p MP4 automatically."
            a.nav-link href="{{videoEditorHref}}" "Connect Kaggle in the video editor"
            label for="notebook-url" "Kaggle notebook URL"
            input#notebook-url type="url" name="notebook_url" required="required" maxlength="400" placeholder="https://www.kaggle.com/code/username/notebook"
            if renderBusy
              p.muted "Linking switches scene tracking to Kaggle. The previous worker may continue running."
            button.secondary type="submit" "Link Kaggle run"
          h2 "Assigned cast"
          if hasCharacters
            for character in characters
              article.detail-row
                strong "{{character.name}}"
                p.muted "{{character.role}}"
          else
            p.muted "No cast members assigned to this scene."
